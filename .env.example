# Linux 上で ./scripts/configure.sh を実行すると .env が自動生成されます。
MIRAKURUN_URL=http://host.docker.internal:40772

# 初期値はホスト自身からのみ接続可能です。
# 遠隔視聴ではサーバーの Tailscale IPv4 アドレスへ変更します。例: 100.64.0.10
BIND_ADDRESS=127.0.0.1

# /dev/dri のホスト側グループ ID。configure.sh が検出します。
VIDEO_GID=44
RENDER_GID=109

# stable / low-load / low-bandwidth。N100では低負荷プロファイルを推奨します。
TRANSCODE_TUNING_PROFILE=low-load

# 個別調整が必要な項目だけコメントを外します。指定値はプロファイルより優先されます。
# TRANSCODE_RATE_CONTROL=qvbr
# TRANSCODE_BITRATE_KBPS=5500
# TRANSCODE_MAX_BITRATE_KBPS=8000
# TRANSCODE_VBV_BUFFER_KBITS=3000
# TRANSCODE_QVBR_QUALITY=23
# TRANSCODE_GOP_LENGTH=60
# TRANSCODE_QUALITY=balanced
# TRANSCODE_DEINTERLACE=none

# 画面最下部の細い帯だけが乱れる場合は 8 を指定。下端を切り、同じ幅の黒帯で戻します。
TRANSCODE_CROP_BOTTOM=0

# software: MPEG-2 は FFmpeg でデコード（問題切り分け用）
# hardware: MPEG-2 デコードも QSV（low-load / low-bandwidth の既定）
# QSVENC_DECODER=hardware

# QSVEncCがMPEG-2シーケンスヘッダーを見つけるための入力解析上限。
# 上限値なので、映像情報を早く取得できれば指定時間いっぱいは待ちません。
# QSVENC_INPUT_ANALYZE_SECONDS=0.5
# QSVENC_INPUT_PROBESIZE=1000000

# 1にするとType-Dデータ放送を削除します。AAC、字幕、EPG/SIは保持されます。
# TSREPLACE_REMOVE_TYPED=0

# N100 では同時 2 ストリームから開始するのが安全です。
MAX_TRANSCODES=2

# reject: BonDriver の SERVICE_SPLIT=0 を検出して拒否（推奨）
# first:  多重化 TS の先頭サービスだけ変換
# passthrough: チャンネル全体の生 TS をそのまま転送
CHANNEL_STREAM_MODE=reject

# 追加オプションはシェル文字列ではなく JSON 配列で指定します。
EXTRA_QSVENC_ARGS_JSON=[]

PROXY_LOG_LEVEL=info
QSVENC_LOG_LEVEL=warn
TSREPLACE_LOG_LEVEL=warn

# tsreplaceによる元MPEG-2 TS解析の上限。通常は1.5秒、情報不足の局では2.0～3.0へ上げます。
TSREPLACE_SOURCE_ANALYZE_SECONDS=1.5
