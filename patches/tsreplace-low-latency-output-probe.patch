+        const char *analyzeEnv = std::getenv("TSREPLACE_SOURCE_ANALYZE_SECONDS");
+        char *analyzeEnd = nullptr;
+        const double configuredAnalyzeSeconds = analyzeEnv ? std::strtod(analyzeEnv, &analyzeEnd) : 1.5;
+        const double sourceAnalyzeSeconds =
+            (analyzeEnd != analyzeEnv && configuredAnalyzeSeconds >= 0.5 && configuredAnalyzeSeconds <= 7.0)
+            ? configuredAnalyzeSeconds : 1.5;
+        format_ctx->max_analyze_duration = static_cast<int64_t>(sourceAnalyzeSeconds * AV_TIME_BASE);
+        format_ctx->probesize = 2 * 1024 * 1024;
+        format_ctx->fps_probe_size = 4;
+        AddMessage(RGY_LOG_DEBUG, _T("Low-latency source probe: %.3f s, 2 MiB, 4 FPS frames.\n"),
